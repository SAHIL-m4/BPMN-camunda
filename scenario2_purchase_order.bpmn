<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   id="Definitions_PurchaseOrder"
                   targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="Process_PurchaseOrder" name="Online Purchase Order Processing" isExecutable="false">

    <bpmn:startEvent id="StartEvent_1" name="Customer places order">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_CheckAvailability" name="Check product availability">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_Available" name="Product available?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes1</bpmn:outgoing>
      <bpmn:outgoing>Flow_No1</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_NotifyOutOfStock" name="Notify customer: out of stock">
      <bpmn:incoming>Flow_No1</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd1</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_OutOfStock" name="Process ends">
      <bpmn:incoming>Flow_ToEnd1</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ProcessPayment" name="Process payment">
      <bpmn:incoming>Flow_Yes1</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_PaymentOK" name="Payment successful?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes2</bpmn:outgoing>
      <bpmn:outgoing>Flow_No2</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_NotifyPaymentFailure" name="Notify customer: payment failure">
      <bpmn:incoming>Flow_No2</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEnd2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_PaymentFailed" name="Process ends">
      <bpmn:incoming>Flow_ToEnd2</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="Task_ConfirmOrder" name="Confirm order">
      <bpmn:incoming>Flow_Yes2</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_PrepareShipment" name="Prepare product for shipment">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_SendShippingConfirmation" name="Send shipping confirmation to customer">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_Shipped" name="Process ends">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckAvailability" targetRef="Gateway_Available" />
    <bpmn:sequenceFlow id="Flow_Yes1" name="Available" sourceRef="Gateway_Available" targetRef="Task_ProcessPayment" />
    <bpmn:sequenceFlow id="Flow_No1" name="Unavailable" sourceRef="Gateway_Available" targetRef="Task_NotifyOutOfStock" />
    <bpmn:sequenceFlow id="Flow_ToEnd1" sourceRef="Task_NotifyOutOfStock" targetRef="EndEvent_OutOfStock" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ProcessPayment" targetRef="Gateway_PaymentOK" />
    <bpmn:sequenceFlow id="Flow_Yes2" name="Success" sourceRef="Gateway_PaymentOK" targetRef="Task_ConfirmOrder" />
    <bpmn:sequenceFlow id="Flow_No2" name="Failed" sourceRef="Gateway_PaymentOK" targetRef="Task_NotifyPaymentFailure" />
    <bpmn:sequenceFlow id="Flow_ToEnd2" sourceRef="Task_NotifyPaymentFailure" targetRef="EndEvent_PaymentFailed" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ConfirmOrder" targetRef="Task_PrepareShipment" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_PrepareShipment" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ShipOrder" targetRef="Task_SendShippingConfirmation" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_SendShippingConfirmation" targetRef="EndEvent_Shipped" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_PurchaseOrder">

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="80" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="58" y="222" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_CheckAvailability_di" bpmnElement="Task_CheckAvailability">
        <dc:Bounds x="160" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Available_di" bpmnElement="Gateway_Available" isMarkerVisible="true">
        <dc:Bounds x="320" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="298" y="145" width="94" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyOutOfStock_di" bpmnElement="Task_NotifyOutOfStock">
        <dc:Bounds x="300" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_OutOfStock_di" bpmnElement="EndEvent_OutOfStock">
        <dc:Bounds x="440" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="418" y="382" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="420" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_PaymentOK_di" bpmnElement="Gateway_PaymentOK" isMarkerVisible="true">
        <dc:Bounds x="580" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="558" y="145" width="94" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_NotifyPaymentFailure_di" bpmnElement="Task_NotifyPaymentFailure">
        <dc:Bounds x="560" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_PaymentFailed_di" bpmnElement="EndEvent_PaymentFailed">
        <dc:Bounds x="700" y="342" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="678" y="382" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ConfirmOrder_di" bpmnElement="Task_ConfirmOrder">
        <dc:Bounds x="680" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_PrepareShipment_di" bpmnElement="Task_PrepareShipment">
        <dc:Bounds x="820" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder">
        <dc:Bounds x="960" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_SendShippingConfirmation_di" bpmnElement="Task_SendShippingConfirmation">
        <dc:Bounds x="1100" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Shipped_di" bpmnElement="EndEvent_Shipped">
        <dc:Bounds x="1240" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1218" y="222" width="80" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="116" y="200" /><di:waypoint x="160" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="260" y="200" /><di:waypoint x="320" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes1_di" bpmnElement="Flow_Yes1">
        <di:waypoint x="370" y="200" /><di:waypoint x="420" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="378" y="182" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No1_di" bpmnElement="Flow_No1">
        <di:waypoint x="345" y="225" /><di:waypoint x="345" y="320" />
        <bpmndi:BPMNLabel><dc:Bounds x="350" y="265" width="60" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd1_di" bpmnElement="Flow_ToEnd1">
        <di:waypoint x="400" y="360" /><di:waypoint x="440" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="520" y="200" /><di:waypoint x="580" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes2_di" bpmnElement="Flow_Yes2">
        <di:waypoint x="630" y="200" /><di:waypoint x="680" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="638" y="182" width="50" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No2_di" bpmnElement="Flow_No2">
        <di:waypoint x="605" y="225" /><di:waypoint x="605" y="360" /><di:waypoint x="660" y="360" />
        <bpmndi:BPMNLabel><dc:Bounds x="610" y="290" width="40" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToEnd2_di" bpmnElement="Flow_ToEnd2">
        <di:waypoint x="660" y="360" /><di:waypoint x="700" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="780" y="200" /><di:waypoint x="820" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="920" y="200" /><di:waypoint x="960" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1060" y="200" /><di:waypoint x="1100" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1200" y="200" /><di:waypoint x="1240" y="200" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
