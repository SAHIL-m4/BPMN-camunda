        <di:waypoint x="540" y="315" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="501" y="262" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="g6_di" bpmnElement="g6">
