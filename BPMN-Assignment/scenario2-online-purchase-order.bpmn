      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_end_oos_di" bpmnElement="s2_end_oos" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="790" y="117" width="36" height="36" />
