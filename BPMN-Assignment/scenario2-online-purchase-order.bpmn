          <dc:Bounds x="1609" y="393" width="82" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="g1_di" bpmnElement="g1" bioc:stroke="#0d4372" color:border-color="#0d4372">
        <di:waypoint x="188" y="230" />
        <di:waypoint x="250" y="232" />
      </bpmndi:BPMNEdge>
