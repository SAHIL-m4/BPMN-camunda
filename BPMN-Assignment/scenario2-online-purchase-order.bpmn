        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_payment_di" bpmnElement="s2_payment" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="540" y="280" width="150" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_pay_di" bpmnElement="s2_pay" isMarkerVisible="true" bioc:stroke="#6b3c00" bioc:fill="#ffe0b2" color:background-color="#ffe0b2" color:border-color="#6b3c00">
        <dc:Bounds x="730" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="790" y="301" width="58" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_fail_di" bpmnElement="s2_fail">
        <dc:Bounds x="820" y="200" width="200" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_end_fail_di" bpmnElement="s2_end_fail" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="1060" y="217" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1042" y="253" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_confirm_di" bpmnElement="s2_confirm">
        <dc:Bounds x="820" y="340" width="140" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_prepare_di" bpmnElement="s2_prepare">
        <dc:Bounds x="1000" y="340" width="190" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_ship_di" bpmnElement="s2_ship">
        <dc:Bounds x="1230" y="340" width="130" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_shipconfirm_di" bpmnElement="s2_shipconfirm" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="1390" y="340" width="190" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2_end_di" bpmnElement="s2_end" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1632" y="357" width="36" height="36" />
