      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_end_rejected_di" bpmnElement="s1_end_rejected" bioc:stroke="#831311" bioc:fill="#ffcdd2" color:background-color="#ffcdd2" color:border-color="#831311">
        <dc:Bounds x="1030" y="287" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1026" y="323" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_insuff_di" bpmnElement="s1_insuff">
