      <bpmndi:BPMNShape id="s1_approve_di" bpmnElement="s1_approve" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="1000" y="100" width="170" height="70" />
