        <bpmndi:BPMNLabel>
          <dc:Bounds x="571" y="389" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_Routing_di" bpmnElement="Flow_Gateway_Routing">
        <di:waypoint x="590" y="298" />
        <di:waypoint x="650" y="298" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="612" y="280" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Routing_Gateway2_di" bpmnElement="Flow_Routing_Gateway2">
        <di:waypoint x="750" y="298" />
        <di:waypoint x="800" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway2_AutoApproved_di" bpmnElement="Flow_Gateway2_AutoApproved">
        <di:waypoint x="825" y="273" />
        <di:waypoint x="825" y="170" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="832" y="219" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway2_Manager_di" bpmnElement="Flow_Gateway2_Manager">
        <di:waypoint x="850" y="298" />
        <di:waypoint x="900" y="298" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="868" y="280" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Gateway3_di" bpmnElement="Flow_Manager_Gateway3">
        <di:waypoint x="1000" y="298" />
