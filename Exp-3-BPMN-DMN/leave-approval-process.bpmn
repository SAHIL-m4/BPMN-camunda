      <bpmndi:BPMNShape id="Gateway_AutoApproved_di" bpmnElement="Gateway_AutoApproved" isMarkerVisible="true">
        <dc:Bounds x="800" y="273" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="785" y="333" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ManagerApproval_di" bpmnElement="UserTask_ManagerApproval">
        <dc:Bounds x="900" y="258" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ManagerDecision_di" bpmnElement="Gateway_ManagerDecision" isMarkerVisible="true">
        <dc:Bounds x="1050" y="273" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1051" y="230" width="49" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="1200" y="273" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyInsufficient_di" bpmnElement="Task_NotifyInsufficient">
        <dc:Bounds x="515" y="460" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_InsufficientBalance_di" bpmnElement="EndEvent_InsufficientBalance">
        <dc:Bounds x="702" y="482" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="681" y="525" width="79" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Approved_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="1622" y="280" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1601" y="316" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateBalance_di" bpmnElement="Task_UpdateBalance">
        <dc:Bounds x="1450" y="258" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ForwardToHR_di" bpmnElement="Task_ForwardToHR">
        <dc:Bounds x="1300" y="258" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyRejected_di" bpmnElement="Task_NotifyRejected">
        <dc:Bounds x="1025" y="430" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_RejectedByManager_di" bpmnElement="EndEvent_RejectedByManager">
        <dc:Bounds x="1252" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1241" y="495" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyAutoApproved_di" bpmnElement="Task_NotifyAutoApproved">
        <dc:Bounds x="775" y="90" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Fetch_di" bpmnElement="Flow_Start_Fetch">
        <di:waypoint x="188" y="298" />
        <di:waypoint x="240" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fetch_Check_di" bpmnElement="Flow_Fetch_Check">
        <di:waypoint x="340" y="298" />
        <di:waypoint x="390" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_Gateway_di" bpmnElement="Flow_Check_Gateway">
        <di:waypoint x="490" y="298" />
        <di:waypoint x="540" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_Insufficient_di" bpmnElement="Flow_Gateway_Insufficient">
        <di:waypoint x="565" y="323" />
