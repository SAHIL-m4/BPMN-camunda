      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway3_Rejected_di" bpmnElement="Flow_Gateway3_Rejected">
        <di:waypoint x="1075" y="323" />
        <di:waypoint x="1075" y="430" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1088" y="353" width="44" height="14" />
        </bpmndi:BPMNLabel>
