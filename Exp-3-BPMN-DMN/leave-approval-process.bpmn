        <di:waypoint x="1100" y="298" />
        <di:waypoint x="1200" y="298" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1131" y="280" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AutoApproved_Merge_di" bpmnElement="Flow_AutoApproved_Merge">
        <di:waypoint x="875" y="130" />
        <di:waypoint x="1225" y="130" />
        <di:waypoint x="1225" y="273" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Merge_HR_di" bpmnElement="Flow_Merge_HR">
        <di:waypoint x="1250" y="298" />
        <di:waypoint x="1300" y="298" />
