        <di:waypoint x="1252" y="470" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UpdateBalance_End_di" bpmnElement="Flow_UpdateBalance_End">
        <di:waypoint x="1550" y="298" />
        <di:waypoint x="1622" y="298" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HR_UpdateBalance_di" bpmnElement="Flow_HR_UpdateBalance">
        <di:waypoint x="1400" y="298" />
        <di:waypoint x="1450" y="298" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
