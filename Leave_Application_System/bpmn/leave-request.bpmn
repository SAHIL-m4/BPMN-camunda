<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 id="Definitions_Leave" targetNamespace="http://example.com/leave">
 <bpmn:process id="leave-request" name="Leave request" isExecutable="true">
  <bpmn:startEvent id="StartEvent_1" name="Leave requested"/>
  <bpmn:sequenceFlow id="f1" sourceRef="StartEvent_1" targetRef="Task_Validate"/>
  <bpmn:serviceTask id="Task_Validate" name="Validate leave request">
   <bpmn:extensionElements><zeebe:taskDefinition type="validate-leave"/></bpmn:extensionElements>
  </bpmn:serviceTask>
  <bpmn:sequenceFlow id="f2" sourceRef="Task_Validate" targetRef="Gateway_Valid"/>
  <bpmn:exclusiveGateway id="Gateway_Valid" name="Request valid?" default="f4"/>
  <bpmn:sequenceFlow id="f3" sourceRef="Gateway_Valid" targetRef="Task_Approve">
   <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= valid</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="f4" sourceRef="Gateway_Valid" targetRef="Gateway_Merge"/>
  <bpmn:userTask id="Task_Approve" name="Manager approval">
   <bpmn:extensionElements><zeebe:formDefinition formId="leave-approval"/></bpmn:extensionElements>
  </bpmn:userTask>
  <bpmn:sequenceFlow id="f5" sourceRef="Task_Approve" targetRef="Gateway_Approved"/>
  <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?" default="f7"/>
  <bpmn:sequenceFlow id="f6" sourceRef="Gateway_Approved" targetRef="Task_FinalApproved">
   <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approved</bpmn:conditionExpression>
  </bpmn:sequenceFlow>
  <bpmn:sequenceFlow id="f7" sourceRef="Gateway_Approved" targetRef="Gateway_Merge"/>
  <bpmn:serviceTask id="Task_FinalApproved" name="Finalize as approved">
   <bpmn:extensionElements><zeebe:taskDefinition type="finalize-leave"/>
    <zeebe:ioMapping><zeebe:input source="&quot;APPROVED&quot;" target="outcome"/></zeebe:ioMapping></bpmn:extensionElements>
  </bpmn:serviceTask>
  <bpmn:sequenceFlow id="f8" sourceRef="Task_FinalApproved" targetRef="End_Approved"/>
  <bpmn:endEvent id="End_Approved" name="Leave approved"/>
  <bpmn:exclusiveGateway id="Gateway_Merge" name="Rejection merge"/>
  <bpmn:sequenceFlow id="f9" sourceRef="Gateway_Merge" targetRef="Task_FinalRejected"/>
  <bpmn:serviceTask id="Task_FinalRejected" name="Finalize as rejected">
   <bpmn:extensionElements><zeebe:taskDefinition type="finalize-leave"/>
    <zeebe:ioMapping><zeebe:input source="&quot;REJECTED&quot;" target="outcome"/></zeebe:ioMapping></bpmn:extensionElements>
  </bpmn:serviceTask>
  <bpmn:sequenceFlow id="f10" sourceRef="Task_FinalRejected" targetRef="End_Rejected"/>
  <bpmn:endEvent id="End_Rejected" name="Leave rejected"/>
 </bpmn:process>
</bpmn:definitions>
